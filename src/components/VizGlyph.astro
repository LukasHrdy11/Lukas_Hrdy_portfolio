---
// Small static line drawings that preview each project's visualization (cards + subpage figure).
import deuteron from '../../public/data/deuteron.json';

interface Props { kind?: string }
const { kind } = Astro.props;
const W = 320;
const H = 180;

function prng(seed: number) {
  return () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let x = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    x = (x + Math.imul(x ^ (x >>> 7), 61 | x)) ^ x;
    return ((x ^ (x >>> 14)) >>> 0) / 4294967296;
  };
}

// kMC: one layer of the sheared hexagonal lattice; sites with (i − j) mod 3 = 0 stay empty
// (corundum cation sublattice), a few sites are dopants.
const rand = prng(48);
const step = 15;
const atoms: { x: number; y: number; dopant: boolean }[] = [];
for (let j = 0; j < 9; j++) {
  for (let i = -5; i < 22; i++) {
    if ((((i - j) % 3) + 3) % 3 === 0) continue;
    const x = 22 + (i + j / 2) * step;
    const y = 30 + j * step * (Math.sqrt(3) / 2);
    if (x < 14 || x > W - 14) continue;
    atoms.push({ x: +x.toFixed(1), y: +y.toFixed(1), dopant: rand() < 0.09 });
  }
}

// Deuteron: the real u(r) and w(r) from the published data file.
const pts = deuteron.points as number[][];
const rMax = pts[pts.length - 1][0];
const sx = (r: number) => 24 + (r / rMax) * (W - 48);
const sy = (v: number) => H - 34 - (v / 0.56) * (H - 64);
const line = (col: number) =>
  pts.map((p, n) => `${n ? 'L' : 'M'}${sx(p[0]).toFixed(1)} ${sy(p[col]).toFixed(1)}`).join(' ');

// STM: a row of surface atoms and the height trace a constant-current tip records above them.
const surface = Array.from({ length: 13 }, (_, n) => 28 + n * 22);
const trace = Array.from({ length: 133 }, (_, n) => {
  const x = 28 + n * 2;
  const y = 92 - 7 * Math.cos(((x - 28) / 22) * 2 * Math.PI);
  return `${n ? 'L' : 'M'}${x} ${y.toFixed(1)}`;
}).join(' ');

const orbits = [18, 30, 44, 60, 84, 108];
---

<svg class="glyph" viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false">
  {
    kind === 'kmc-crystal' && (
      <g>
        {atoms.map((a) => (
          <circle cx={a.x} cy={a.y} r={a.dopant ? 4.4 : 3.6} class={a.dopant ? 'warm-fill' : 'cool-fill'} />
        ))}
      </g>
    )
  }
  {
    kind === 'deuteron-wavefunction' && (
      <g fill="none">
        <path d={`M24 ${sy(0)} H${W - 24}`} class="axis" />
        <path d={`M24 ${sy(0)} V24`} class="axis" />
        <path d={line(1)} class="cool" stroke-width="2" />
        <path d={line(2)} class="warm" stroke-width="2" />
      </g>
    )
  }
  {
    kind === 'stm-tip-animation' && (
      <g>
        {surface.map((x) => <circle cx={x} cy="132" r="9.5" class="cool-fill" opacity="0.55" />)}
        <path d={trace} fill="none" class="warm" stroke-width="1.6" />
        <path d="M150 20 h28 l-10 42 l-4 16 l-4 -16 z" fill="none" class="cool" stroke-width="1.6" stroke-linejoin="round" />
      </g>
    )
  }
  {
    kind === 'hero-solar-system' && (
      <g transform="rotate(-14 170 90)">
        <g fill="none" class="cool" opacity="0.6">
          {orbits.map((a) => <ellipse cx="170" cy="90" rx={a} ry={+(a * 0.42).toFixed(1)} />)}
        </g>
        <path d="M30 18 Q190 86 96 172" fill="none" class="warm" stroke-dasharray="2 5" />
        <circle cx="96" cy="50" r="2.6" class="warm-fill" />
        <circle cx="170" cy="90" r="5" class="warm-fill" />
        <circle cx="198" cy="96" r="2" class="cool-fill" />
        <circle cx="133" cy="76" r="2.4" class="cool-fill" />
        <circle cx="236" cy="70" r="3.2" class="cool-fill" />
        <circle cx="92" cy="110" r="2.8" class="cool-fill" />
      </g>
    )
  }
</svg>

<style>
  .glyph { width: 100%; height: auto; }
  .cool { stroke: var(--c-ice); }
  .warm { stroke: var(--c-amber); }
  .cool-fill { fill: #5f9fc9; }
  .warm-fill { fill: var(--c-amber); }
  .axis { stroke: var(--c-line-strong); }
</style>
