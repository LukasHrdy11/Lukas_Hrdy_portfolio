---
import { Picture } from 'astro:assets';
import portrait from '../assets/lukas-hrdy.jpg';
import Section from './Section.astro';
import { useT, type Lang } from '../i18n/ui';
import { profile } from '../lib/profile';
import { loc } from '../lib/typo';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
---

<Section id="about" title={t('about.title')}>
  <div class="about">
    <div class="about__text">
      <p class="about__lead">{loc(profile.about, lang)}</p>

      <h3 class="about__sub">{t('about.interests')}</h3>
      <ul class="chips">
        {profile.interests.map((item) => <li>{loc(item, lang)}</li>)}
      </ul>
    </div>

    <figure class="about__photo">
      <Picture
        src={portrait}
        alt={t('about.photoAlt')}
        formats={['avif', 'webp']}
        widths={[240, 360, 480, 720]}
        sizes="(min-width: 44rem) 17rem, 12rem"
        loading="lazy"
        decoding="async"
      />
    </figure>
  </div>
</Section>

<style>
  .about {
    display: grid;
    gap: var(--s-6);
  }
  .about__lead {
    max-width: var(--measure);
    font-size: var(--t-lead);
  }
  .about__sub {
    margin-top: var(--s-6);
    font-family: var(--f-text);
    font-size: var(--t-sm);
    font-weight: 500;
    color: var(--c-dim);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-top: var(--s-3);
    max-width: var(--measure);
  }
  .chips li {
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--c-line-strong);
    border-radius: var(--r-sm);
    font-size: var(--t-sm);
    line-height: 1.4;
    color: var(--c-star);
  }

  .about__photo {
    margin: 0;
    width: 12rem;
    order: -1;
  }
  .about__photo :global(img) {
    width: 100%;
    aspect-ratio: 847 / 900;
    object-fit: cover;
    border: 1px solid var(--c-line-strong);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-figure);
    /* The portrait was taken in bright daylight; calm it a little for the night palette. */
    filter: saturate(0.82) brightness(0.94);
  }

  @media (min-width: 44rem) {
    .about {
      grid-template-columns: minmax(0, 1fr) 17rem;
      gap: var(--s-7);
      align-items: start;
    }
    .about__photo { width: 100%; order: 0; }
  }
</style>
