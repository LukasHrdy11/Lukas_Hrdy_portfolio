---
// Hero centrepiece (PLAN.md §6.1): live 3D Solar System computed from orbital elements.
// The static SVG (HeroScene) is rendered first and stays when WebGL or JS is unavailable.
import HeroScene from './HeroScene.astro';
import { useT, type Lang, type UiKey } from '../i18n/ui';
import { withBase } from '../lib/paths';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);

const bodyKeys = ['Sun', 'Mercury', 'Venus', 'EM_Bary', 'Mars', 'Jupiter', 'Saturn', 'Uranus', 'Neptune', 'comet'];
const strings = {
  lang,
  play: t('solar.play'),
  pause: t('solar.pause'),
  names: Object.fromEntries(bodyKeys.map((k) => [k, t(`body.${k}` as UiKey)])),
};
// Simulated days per second of real time.
const speeds: [number, UiKey][] = [
  [1, 'solar.speed.day'],
  [7, 'solar.speed.week'],
  [30.4375, 'solar.speed.month'],
  [365.25, 'solar.speed.year'],
];
---

<div class="solar" data-solar data-orbits={withBase('/data/orbits.json')} data-strings={JSON.stringify(strings)}>
  <div class="solar__fallback"><HeroScene lang={lang} /></div>
  <canvas class="solar__canvas" tabindex="0" role="img" aria-label={t('solar.alt')} aria-describedby="solar-hint"></canvas>
  <p id="solar-hint" class="visually-hidden">{t('solar.hint')}</p>
  <div class="solar__labels" data-labels aria-hidden="true"></div>

  <div class="solar__controls" data-controls role="group" aria-label={t('solar.controls')} hidden>
    <button type="button" class="solar__btn solar__btn--icon" data-act="play" aria-pressed="false" aria-label={t('solar.play')}>
      <svg class="solar__icon-play" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M4 2.5v11l9-5.5z" fill="currentColor"></path></svg>
      <svg class="solar__icon-pause" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3.5 2.5h3v11h-3zM9.5 2.5h3v11h-3z" fill="currentColor"></path></svg>
    </button>
    <select class="solar__select" data-speed aria-label={t('solar.speed')}>
      {speeds.map(([days, key]) => <option value={days} selected={days === 7}>{t(key)}</option>)}
    </select>
    <output class="solar__date" data-date aria-label={t('solar.date')}></output>
    <button type="button" class="solar__btn" data-act="now">{t('solar.now')}</button>
    <button type="button" class="solar__btn" data-act="labels" aria-pressed="false">{t('solar.labels')}</button>
    <button type="button" class="solar__btn solar__btn--icon" data-act="zoom-out" aria-label={t('solar.zoomOut')} title={t('solar.zoomOut')}>−</button>
    <button type="button" class="solar__btn solar__btn--icon" data-act="zoom-in" aria-label={t('solar.zoomIn')} title={t('solar.zoomIn')}>+</button>
  </div>
</div>

<script>
  // three.js is fetched only once the scene scrolls near the viewport.
  for (const root of document.querySelectorAll<HTMLElement>('[data-solar]')) {
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        import('../scripts/solar-system')
          .then((m) => m.mountSolarSystem(root))
          .catch(() => {
            /* the static SVG stays */
          });
      },
      { rootMargin: '200px' },
    );
    io.observe(root);
  }
</script>

<style is:global>
  .solar {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  .solar__fallback,
  .solar__canvas,
  .solar__labels {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .solar__fallback { transition: opacity 600ms var(--ease), visibility 0s 600ms; }
  .solar__canvas {
    display: block;
    opacity: 0;
    cursor: grab;
    /* touch: horizontal drag rotates, vertical swipe still scrolls the page */
    touch-action: pan-y;
    transition: opacity 600ms var(--ease);
  }
  .solar__canvas:focus-visible { outline-offset: -4px; }
  .solar.is-dragging .solar__canvas { cursor: grabbing; }
  .solar.is-live .solar__canvas { opacity: 1; }
  .solar.is-live .solar__fallback { opacity: 0; visibility: hidden; }

  .solar__labels { pointer-events: none; }
  .solar__label {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    gap: 0.6em;
    margin: -0.7em 0 0 0.85rem;
    font-family: var(--f-mono);
    font-size: 0.75rem;
    line-height: 1.4;
    white-space: nowrap;
    color: var(--c-star);
    text-shadow: 0 0 4px var(--c-night), 0 0 10px var(--c-night);
    will-change: transform;
  }
  .solar__label[hidden] { display: none; }
  .solar__label-dist { color: var(--c-dim); font-variant-numeric: tabular-nums; }

  .solar__controls {
    position: absolute;
    right: var(--gutter);
    bottom: var(--s-4);
    left: var(--gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    font-family: var(--f-mono);
    font-size: 0.75rem;
    pointer-events: none;
  }
  .solar__controls[hidden] { display: none; }
  .solar__controls > * { pointer-events: auto; }

  .solar__btn,
  .solar__select {
    min-height: 2rem;
    padding: 0 var(--s-3);
    border: 1px solid var(--c-line-strong);
    border-radius: var(--r-sm);
    background: rgb(7 11 20 / 0.72);
    color: var(--c-star);
    font: inherit;
    cursor: pointer;
    transition: border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }
  .solar__btn:hover,
  .solar__select:hover { border-color: var(--c-ice); color: var(--c-ice); }
  .solar__btn--icon {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    padding: 0;
    font-size: 1rem;
    line-height: 1;
  }
  .solar__btn[data-act='labels'][aria-pressed='true'] { border-color: var(--c-ice); color: var(--c-ice); }
  .solar__btn[aria-pressed='true'] .solar__icon-play,
  .solar__btn[aria-pressed='false'] .solar__icon-pause { display: none; }
  .solar__date {
    min-width: 14ch;
    padding: 0 var(--s-2);
    color: var(--c-dim);
    font-variant-numeric: tabular-nums;
    text-align: center;
    text-shadow: 0 0 6px var(--c-night);
  }

  @media (pointer: coarse) {
    .solar__btn,
    .solar__select { min-height: 2.5rem; }
    .solar__btn--icon { width: 2.5rem; }
  }

  /* Wide hero: text on the left, controls tucked into the lower right corner. */
  @media (min-width: 56rem) {
    .solar__controls {
      left: auto;
      bottom: var(--s-5);
      max-width: 19rem;
      justify-content: flex-end;
    }
  }
  @media (min-width: 76rem) {
    .solar__controls { max-width: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .solar__fallback,
    .solar__canvas { transition: none; }
  }
</style>
