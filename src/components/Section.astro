---
interface Props { id: string; title: string }
const { id, title } = Astro.props;
---

<section id={id} class="section" aria-labelledby={`${id}-title`}>
  <div class="container section__grid">
    <h2 id={`${id}-title`} class="section__title">{title}</h2>
    <div class="section__body"><slot /></div>
  </div>
</section>

<style>
  .section {
    padding-block: var(--s-8);
    border-top: 1px solid var(--c-line);
  }
  .section__grid { display: grid; gap: var(--s-5); }
  .section__title { font-size: var(--t-h2); }
  .section__body { min-width: 0; }

  /* Wide screens: the section name sits in a margin column, like a note beside the text. */
  @media (min-width: 64rem) {
    .section { padding-block: var(--s-9); }
    .section__grid {
      grid-template-columns: var(--margin-col) minmax(0, 1fr);
      gap: var(--s-7);
    }
    .section__title {
      position: sticky;
      top: calc(var(--header-h) + var(--s-5));
      align-self: start;
      font-size: var(--t-h3);
      font-style: italic;
      color: var(--c-dim);
    }
  }
</style>
